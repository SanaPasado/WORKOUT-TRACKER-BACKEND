# Copy this file to .env and fill in real values
# Never commit your real .env

# Django / deployment
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

GEMINI_API_KEY=
GEMINI_MODEL=

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# SMTP (sender account)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ANGRIT <sender@gmail.com>

PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000/verify-email

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_CURRENCY=USD
PAYPAL_PREMIUM_PRICE=4.99
PAYPAL_RETURN_URL=http://localhost:3000/premium-success
PAYPAL_CANCEL_URL=http://localhost:3000/dashboard
